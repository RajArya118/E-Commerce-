# -----------------------------------------------------------------------------
# NOVA STORE — ENVIRONMENT VARIABLES
# -----------------------------------------------------------------------------

# APPLICATION
PROJECT_NAME="NOVA STORE"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
FRONTEND_URL="http://localhost:5173"

# DATABASE (MongoDB Atlas or Local MongoDB)
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="nova_store_db"

# AUTHENTICATION (JWT)
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# RAZORPAY PAYMENT GATEWAY (Test Mode Keys)
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourTestKeySecretHere"
RAZORPAY_CURRENCY="INR"

# AI SHOPPING ASSISTANT
GEMINI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"

# ADMIN SEED ACCOUNT
ADMIN_DEFAULT_EMAIL="admin@novastore.com"
ADMIN_DEFAULT_PASSWORD=""
CUSTOMER_DEFAULT_PASSWORD=""
